#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/adc/nrf-saadc.h>

/* Bluetooth on nRF54L15 needs both the high- and low-frequency clocks. */
&xo {
        status = "okay";
};

&lfclk {
        status = "okay";
};

/*
 * Battery measurement: the CR2032 feeds VDD, and the nRF54L15 SAADC can route
 * VDD to a channel internally - no divider, no extra pin, no soldering.
 *
 * On nRF54L15 this works through PSELP.CONNECT = Internal with
 * PSELP.INTERNAL = Vdd (NOT the nRF52-style PSELP.PSELP = VDD encoding), but
 * the devicetree-facing value is the same NRF_SAADC_VDD and the driver asserts
 * that the two definitions agree.
 *
 * Gain 1/4 keeps a fresh cell in range: the internal reference is 0.9 V, so the
 * full scale is 0.9 / (1/4) = 3.6 V. With gain 1 the 3.0-3.3 V of a fresh
 * CR2032 would sit far above the 0.9 V full scale and read as saturated.
 */
&adc {
        status = "okay";

        #address-cells = <1>;
        #size-cells = <0>;

        channel@0 {
                reg = <0>;

                zephyr,gain = "ADC_GAIN_1_4";
                zephyr,reference = "ADC_REF_INTERNAL";
                zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
                zephyr,input-positive = <NRF_SAADC_VDD>;
                zephyr,resolution = <12>;
                /* 2^4 = 16 hardware averages per sample: a battery reading
                 * does not need speed, only a quiet number. */
                zephyr,oversampling = <4>;
        };
};

/ {
        zephyr,user {
                /* Channel 0 above is the battery. */
                io-channels = <&adc 0>;
        };
};

/* UART (P1.04 TX / P1.05 RX) is not used: P1.05 is repurposed as the LIS2DH12
 * INT1 wake line (see the board overlay irq-gpios). Disable uart20 so the
 * UARTE driver never touches P1.04/P1.05. */
&uart20 {
	status = "disabled";
};

/ {
	aliases {
		/* Wheel pulse input for CONFIG_CSC_WHEEL_SENSOR_GPIO
		 * (Hall sensor / magnetic pulse contact). Default pad: P1.06 -
		 * change it to the pad you actually wired. Must be a
		 * GPIOTE-capable port: P0 or P1 on nRF54L15 (P2 has no
		 * GPIOTE!).
		 */
		wheel-sensor = &wheel_sensor;
	};

	/*
	 * The wheel pulse input is described as a gpio-keys child: only a
	 * node covered by a binding that declares the 'gpios' property gets
	 * the devicetree macros (DT_N_..._P_gpios_...) needed by
	 * GPIO_DT_SPEC_GET(). The input subsystem itself is not used - the
	 * wheel_sensor module counts revolutions through its own interrupt.
	 */
	wheel_input: wheel-input {
		compatible = "gpio-keys";

		wheel_sensor: wheel-sensor {
			/* Switch/sensor between this pin and GND; the SoC
			 * pull-up keeps the line high while the contact is
			 * open.
			 */
			gpios = <&gpio1 6 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			label = "Wheel sensor";
			zephyr,code = <INPUT_KEY_0>;
		};
	};
};
